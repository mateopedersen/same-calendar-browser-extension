{
  "manifest_version": 3,
  "name": "Same Calendar — Calendar & Print Planner",
  "version": "1.0.0",
  "description": "A private offline calendar with personal events, printable planners, and practical date tools.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Same Calendar" },
  "options_page": "planner.html",
  "homepage_url": "https://www.betacalendars.com/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
